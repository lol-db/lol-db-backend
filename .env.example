# 이 파일을 프로젝트 루트의 .env로 복사하고 계정과 비밀번호를 채우세요.
# 값은 따옴표 없이 입력합니다. 실제 .env는 Git에 올리지 않습니다.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=riftdata
DB_USERNAME=
DB_PASSWORD=
# 테스트 DB 이름. 비워 두지 말고, 바꿀 때만 앞의 #을 지운다 (기본 riftdata_test)
# TEST_DB_NAME=riftdata_test

# (선택) 서버만 다른 계정으로 띄울 때. 예: 발표 시연의 조회 전용 계정 riftdata_app (sql/demo/01_users_grants.sql)
# 쓸 때만 앞의 #을 지우고 채운다. 빈 값(DB_APP_USERNAME=)은 기본값으로 바뀌지 않아 접속이 실패한다.
# 주석으로 두면 위 DB_USERNAME, DB_PASSWORD를 쓴다. 테스트는 항상 위 계정을 쓴다.
# DB_APP_USERNAME=riftdata_app
# DB_APP_PASSWORD=
