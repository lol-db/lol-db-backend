# 배포 서버(VM)의 docker compose 설정. 이 파일을 저장소 루트의 prod.env로 복사하고 비밀번호를 채운다.
#   cp deploy/prod.env.example prod.env
# prod.env는 .gitignore(*.env)에 있어 커밋되지 않는다. 값은 따옴표 없이 쓰고, 비밀번호에 $는 쓰지 않는다.

# MySQL root 비밀번호 (컨테이너 관리용)
DB_ROOT_PASSWORD=
# 쓰기 계정: CSV 적재·재계산용 (riftdata DB 전체 권한)
DB_USERNAME=riftdata
DB_PASSWORD=
# 서버용 조회 전용 계정 (SELECT만)
DB_APP_USERNAME=riftdata_app
DB_APP_PASSWORD=

# 백엔드를 열 포트 (VM 방화벽도 같은 포트를 연다)
BACKEND_PORT=8080
# 허용할 프론트 주소. 여러 개는 쉼표로 구분. 비우면 다른 출처의 브라우저 요청을 막는다.
CORS_ALLOWED_ORIGINS=
